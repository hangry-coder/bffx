{
  "site": {
    "title": "Notes App Admin",
    "theme": "dark",
    "default_per_page": 15,
    "menu": [
      {
        "label": "Dashboard",
        "page": "dashboard"
      },
      {
        "label": "Users",
        "page": "users",
        "priority": 8
      },
      {
        "label": "Resources",
        "priority": 80,
        "children": [
          {
            "label": "Devices",
            "page": "resource:Device",
            "priority": 100
          },
          {
            "label": "Other Resources",
            "page": "resources",
            "priority": 999
          }
        ]
      },
      {
        "label": "Settings",
        "priority": 90,
        "children": [
          {
            "label": "App Settings",
            "page": "app-settings",
            "priority": 10
          },
          {
            "label": "Docs",
            "priority": 20,
            "children": [
              {
                "label": "API Reference",
                "page": "api-docs"
              },
              {
                "label": "BFFX Guide",
                "page": "bffx-docs",
                "priority": 10
              }
            ]
          }
        ]
      }
    ],
    "session": {},
    "session_resolved": {
      "max_age_seconds": 0,
      "idle_timeout_seconds": 0,
      "dev_unlimited": true
    },
    "features": {
      "api_docs": true
    },
    "export": {
      "csv_enabled": true
    }
  },
  "dashboard": {
    "widgets": [
      {
        "type": "metric",
        "title": "Total Notes",
        "query": {
          "aggregate": "count",
          "resource": "Note"
        }
      }
    ]
  },
  "pages": null,
